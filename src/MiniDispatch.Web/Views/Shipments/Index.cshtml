@using MiniDispatch.Domain.Enums
@model IReadOnlyList<MiniDispatch.Application.Shipments.Queries.GetShipments.ShipmentListItemDto>

@{
    ViewData["Title"] = "Sevkiyatlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Sevkiyatlar</h1>

    <a asp-controller="Shipments"
       asp-action="Create"
       class="btn btn-primary">
        Yeni sevkiyat
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-controller="Shipments"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Tümü
    </a>

    <a asp-controller="Shipments"
       asp-action="Index"
       asp-route-status="Created"
       class="btn btn-outline-primary">
        Oluşturuldu
    </a>

    <a asp-controller="Shipments"
       asp-action="Index"
       asp-route-status="InTransit"
       class="btn btn-outline-warning">
        Yolda
    </a>

    <a asp-controller="Shipments"
       asp-action="Index"
       asp-route-status="Delivered"
       class="btn btn-outline-success">
        Teslim edildi
    </a>
</div>

<div id="shipments-table"
     data-table-url="@Url.Action("Table", "Shipments")"
     data-hub-url="@Url.Content("~/hubs/shipments")">
    <partial name="_ShipmentsTable" model="Model" />
</div>
<div id="shipments-live-status" class="text-muted small mt-2" role="status" aria-live="polite">Canlı güncelleme başlatılıyor…</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/shipments.js" asp-append-version="true"></script>
}
